		{
			"name": "\nhttps://api.evbtranding.site/api/transactions/withdrawals/my-requests",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code hợp lệ\", function () {\r",
							"  pm.expect([200, 403]).to.include(pm.response.code);\r",
							"});\r",
							"\r",
							"pm.test(\"Response là JSON\", function () {\r",
							"  pm.expect(pm.response.headers.get(\"Content-Type\"))\r",
							"    .to.include(\"application/json\");\r",
							"});\r",
							"\r",
							"const json = pm.response.json();\r",
							"\r",
							"if (pm.response.code === 200) {\r",
							"  pm.test(\"Có danh sách withdrawal\", function () {\r",
							"    pm.expect(json).to.have.property(\"data\");\r",
							"    pm.expect(json.data).to.be.an(\"array\");\r",
							"  });\r",
							"}\r",
							"\r",
							"if (pm.response.code === 403) {\r",
							"  pm.test(\"User không có quyền withdrawal\", function () {\r",
							"    pm.expect(json).to.have.property(\"success\", false);\r",
							"    pm.expect(json).to.have.property(\"message\");\r",
							"  });\r",
							"}\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
